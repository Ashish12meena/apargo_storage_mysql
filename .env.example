# =====================================================================================
# storage-service — environment variables (generated from application*.yml; keep in sync)
#
#   cp .env.example .env        then uncomment ONLY what you need to change.
#
# Precedence, highest first: real environment variables > ./.env > ../platform.env >
# the defaults in application*.yml (shown below). A commented line keeps its default.
# NEVER write an empty value (VAR=): an empty value REPLACES the default with "".
# No inline comments: in this format '#' starts a comment only at the start of a line.
# .env is git-ignored; never commit real values. See docs/configuration in the platform docs.
# =====================================================================================

# ---- Profile -------------------------------------------------------------------------------
# Path of the shared platform.env (default ../platform.env, relative to the working directory).
# APARGO_PLATFORM_ENV=../platform.env
# Spring profile: dev on a developer machine / dev server, prod in production.
# SPRING_PROFILES_ACTIVE=dev

# ---- Shared infrastructure — normally set ONCE in ../platform.env; set here only to override for this service ---
# Platform MySQL host (DB_HOST overrides it for this service only).
# MYSQL_HOST=localhost
# Platform MySQL port (DB_PORT overrides it for this service only).
# MYSQL_PORT=3306
# Platform database name — apargo_wa_messaging in production (DB_NAME overrides it for this service only).
# MYSQL_DATABASE=apargo_storage
# Redis host.
# REDIS_HOST=146.88.24.123
# Redis port.
# REDIS_PORT=6379
# Kafka brokers, host:port[,host:port].
#   (prod profile: required, no default)
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# STORAGE_SERVICE_PORT=8030
# STORAGE_SERVICE_URL=http://localhost:8030

# ---- Database (this service) ---------------------------------------------------------------
# Full JDBC URL. When set it wins over every DB_* / MYSQL_* part below.
# DB_URL=jdbc:mysql://localhost:3306/apargo_storage
# This service's MySQL host, if different from MYSQL_HOST.
# DB_HOST=localhost
# This service's MySQL port, if different from MYSQL_PORT.
# DB_PORT=3306
# This service's database. Locally each service has its own; production uses apargo_wa_messaging.
# DB_NAME=apargo_storage
# MySQL user for this service.
# DB_USERNAME=root
# MySQL password for this service.
# DB_PASSWORD=<secret>
# Hikari maximum pool size.
# DB_POOL_MAX=30
# Hikari minimum idle connections.
# DB_POOL_MIN_IDLE=10
# Hibernate ddl-auto (update in dev; the prod profile pins validate where it has one).
# JPA_DDL_AUTO=update
# FLYWAY_ENABLED=false

# ---- Internal API auth and encryption — disabled for now, ready to enable ------------------
# Internal API-key auth for /internal/** — false for now; set true together with the keys to enable it.
# INTERNAL_API_AUTH_ENABLED=false
# INTERNAL_API_KEY_TEMPLATE=<secret>
# INTERNAL_API_KEY_CHAT=<secret>
# INTERNAL_API_KEY_ORG=<secret>
# INTERNAL_API_KEY_CONTACT=<secret>
# INTERNAL_API_KEY_MESSAGING=<secret>

# ---- Other secrets (this service only) -----------------------------------------------------
# Redis password.
# REDIS_PASSWORD=<secret>

# ---- Service settings ----------------------------------------------------------------------
# MULTIPART_MAX_FILE_SIZE=20MB
# MULTIPART_MAX_REQUEST_SIZE=100MB
# KAFKA_CLIENT_ID=<spring.application.name>
# KAFKA_DELIVERY_TIMEOUT_MS=120000
# KAFKA_MAX_BLOCK_MS=10000
# HTTP port for this service only; normally the port comes from <NAME>_SERVICE_PORT in ../platform.env.
# SERVER_PORT=8030
# TOMCAT_MAX_THREADS=200
# STORAGE_PROVIDER=local
# MAX_FILES_PER_BATCH=20
# LOCAL_STORAGE_ROOT=./media-uploads
# LOCAL_STORAGE_BASE_URL=http://localhost:8030/api/v1/media/serve
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=
# CLOUDFRONT_DOMAIN=
# S3_KMS_KEY_ID=
# S3_STORAGE_CLASS=INTELLIGENT_TIERING
# PRESIGNED_UPLOAD_ENABLED=false
# PRESIGNED_UPLOAD_THRESHOLD_BYTES=33554432
# MEDIA_MAX_BYTES=16777216
# MEDIA_MAX_BYTES_IMAGE=8388608
# MEDIA_MAX_BYTES_VIDEO=16777216
# MEDIA_MAX_BYTES_AUDIO=16777216
# MEDIA_MAX_BYTES_DOCUMENT=16777216
# MEDIA_SCANNING_ENABLED=false
# MEDIA_SCANNING_PROVIDER=noop
# MEDIA_SCANNING_ENDPOINT=
# MEDIA_SCANNING_BLOCK_DOWNLOAD=false
# QUOTA_ALLOW_PROJECT_OVERCOMMIT=true
# QUOTA_TEARDOWN_BATCH_SIZE=500
# SCHEDULING_ENABLED=true
# SCHEDULING_POOL_SIZE=4
# AUDIT_ENABLED=true
# AUDIT_SOURCE_SERVICE=<spring.application.name>
# development | staging | production (the audit service dead-letters a mismatch).
#   (prod profile default: production)
# AUDIT_ENVIRONMENT=development
# AUDIT_TOPIC=apargo.audit.events
# AUDIT_PUBLISHER_POOL_SIZE=2
# AUDIT_PUBLISHER_QUEUE_CAPACITY=10000
# AUDIT_PUBLISHER_AWAIT_TERMINATION_SECONDS=15
# AUDIT_PUBLISHER_THREAD_NAME_PREFIX=audit-publisher-
# API_IDEMPOTENCY_KEY_REQUIRED=true
# Comma-separated browser origins; * = any.
# CORS_ALLOWED_ORIGINS=*
# CORS_ALLOW_CREDENTIALS=true
# Actuator endpoints exposed over HTTP, comma-separated.
# MANAGEMENT_ENDPOINTS=health,info,metrics,prometheus
# Health details: never | when-authorized | always.
#   (prod profile default: never)
# MANAGEMENT_HEALTH_DETAILS=when-authorized
# TRACE_SAMPLE_RATE=0.1
# Root log level.
# LOG_LEVEL_ROOT=INFO
# Log level of this service's own packages.
#   (dev profile default: DEBUG)
# LOG_LEVEL_APP=INFO
# LOG_LEVEL_API=INFO
# LOG_LEVEL_APPLICATION=INFO
# LOG_LEVEL_STORAGE=DEBUG
# LOG_LEVEL_OUTBOX=INFO
# LOG_LEVEL_RATELIMIT=INFO
# LOG_LEVEL_SCHEDULER=INFO
# LOG_LEVEL_AUDIT=INFO
# LOG_LEVEL_ACCESS=INFO
# org.hibernate.SQL log level (DEBUG prints statements).
# LOG_LEVEL_SQL=WARN
# org.hibernate.orm.jdbc.bind log level (TRACE prints bound parameters).
# LOG_LEVEL_SQL_BIND=WARN
# LOG_LEVEL_KAFKA=WARN
# LOG_LEVEL_HIKARI=DEBUG
# LOG_FILE=
# LOG_FILE_MAX_SIZE=100MB
# LOG_FILE_MAX_HISTORY=14
# LOG_FILE_TOTAL_CAP=3GB
# LOG_REQUEST_ENABLED=true
#   (dev profile default: true)
# LOG_REQUEST_START=false
#   (dev profile default: INFO)
# LOG_REQUEST_START_LEVEL=DEBUG
# LOG_REQUEST_LEVEL=INFO
#   (dev profile default: PT5S)
# LOG_REQUEST_SLOW_THRESHOLD=PT2S
# LOG_REQUEST_MAX_QUERY=256
#   (dev profile default: true)
# LOG_REQUEST_HEADERS=false
# Print SQL to stdout.
# JPA_SHOW_SQL=false
# LOG_STRUCTURED_FORMAT=ecs
# SERVICE_VERSION=2.0.0
# DEPLOY_ENV=production

# ---- Older names — still honoured as fallbacks, use the new name instead -------------------
# DB_POOL_MAX_SIZE  ->  use DB_POOL_MAX
# DDL_AUTO  ->  use JPA_DDL_AUTO
# SECURITY_API_KEY_ENABLED  ->  use INTERNAL_API_AUTH_ENABLED
# TEMPLATE_SERVICE_API_KEY  ->  use INTERNAL_API_KEY_TEMPLATE
# CHAT_SERVICE_API_KEY  ->  use INTERNAL_API_KEY_CHAT
# ORG_SERVICE_API_KEY  ->  use INTERNAL_API_KEY_ORG
# LOG_LEVEL  ->  use LOG_LEVEL_APP
# LOG_SQL  ->  use LOG_LEVEL_SQL
